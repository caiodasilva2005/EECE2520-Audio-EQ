[Unit]
Description=Audio-EQ DAC writer daemon (MCP4822)
After=local-fs.target

[Service]
Type=simple
WorkingDirectory=/opt/EECE2520-Audio-EQ
ExecStart=/opt/EECE2520-Audio-EQ/.venv/bin/python /opt/EECE2520-Audio-EQ/source/dac-writer/main.py
RuntimeDirectory=audio-eq
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
